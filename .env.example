# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bito
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/bito

# Application
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BITO

# Security & Crypto
CREDENTIAL_ENCRYPTION_KEY=
CRON_SECRET=replace_with_random_cron_secret

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BITO
WEBAUTHN_ORIGIN=http://localhost:3000

# File Storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Settings
ALLOW_REGISTRATION=true
TICK_BUDGET_MS=45000
ALLOW_PRIVATE_HTTP=false

# AI (Gemini)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_PLATFORM_API_KEY=

# Meta / WhatsApp
GRAPH_API_VERSION=v20.0

# Google OAuth (Phase 14)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
