{
  "name": "bito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel exec tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.acceptance.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "build": "pnpm --filter @bito/web build",
    "db:migrate": "tsx scripts/migrate.ts",
    "gen:key": "tsx scripts/gen-key.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "postgres": "^3.4.9",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
